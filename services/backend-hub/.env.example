# Backend Hub — Environment Variables
# Copy this to .env and fill in values

# Railway injects PORT automatically — do not set manually on Railway
PORT=4000

# URL of this Hub (Railway will give you: https://backend-hub-xxxx.up.railway.app)
HUB_PUBLIC_BASE_URL=https://your-hub.up.railway.app

# n8n webhook URL (from your Railway n8n service)
N8N_BLOG_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/blog-run

# FB Backend URL (from your Railway fb-backend service)
FB_BACKEND_URL=https://your-fb-backend.up.railway.app

# CORS — your Vercel dashboard URL (or * for open access)
DASHBOARD_ORIGIN=https://your-dashboard.vercel.app

# Telegram (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
