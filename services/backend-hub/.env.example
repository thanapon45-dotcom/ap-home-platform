# ============================================================
#  Hub v2 — Environment Variables
#  Copy this file to .env and fill in real values
#  Keys marked (required) will throw at startup if missing
# ============================================================

# --- Hub Core ---
PORT=3001                                 # 3001 = v2 shadow, 3000 = production
HUB_SECRET=your_hub_secret_here           # x-hub-token for API auth (required)
HUB_VERSION=2.0.0

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co     # (required)
SUPABASE_SERVICE_KEY=eyJ...               # service_role key (required)

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-...              # Claude provider (required)
OPENAI_API_KEY=sk-...                     # OpenAI + vision (required)
GEMINI_API_KEY=AIza...                    # Gemini fallback (optional)
AI_DAILY_BUDGET_USD=5.00                  # daily token spend limit USD

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...          # Bot token (required) ← must match Config.ts
TELEGRAM_CHAT_ID=8589960853              # Target chat/group ID (required)

# --- LINE ---
LINE_CHANNEL_SECRET=abc123...             # For webhook signature verify
LINE_CHANNEL_ACCESS_TOKEN=xxx...          # For reply API

# --- WordPress ---
WP_URL=https://finnhouses.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Facebook ---
FB_PAGE_ID=123456789
FB_PAGE_ACCESS_TOKEN=EAABxx...            # Expires ~Aug 2, 2026
FB_BACKEND_URL=https://fb-backend.up.railway.app
FB_BACKEND_SECRET=your_fb_backend_secret

# --- n8n ---
N8N_WEBHOOK_BASE_URL=https://n8n.ap-home.co.th/webhook

# --- Legacy (v1 compat — keep until cutover) ---
HUB_PUBLIC_BASE_URL=https://your-hub.up.railway.app
DASHBOARD_ORIGIN=https://ap-home.vercel.app
