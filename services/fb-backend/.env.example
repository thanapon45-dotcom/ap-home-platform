# FB Backend — Environment Variables
# Copy this to .env and fill in values

# Railway injects PORT automatically — do not set manually on Railway
PORT=3001

# Facebook Graph API credentials
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_token_here
FB_PAGE_ID=107645087471724
FB_API_VERSION=v21.0

# Hub webhook URL (from your Railway backend-hub service)
HUB_FB_WEBHOOK_URL=https://your-hub.up.railway.app/webhook/fb
