# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI — Image Generation ────────────────────────────────────────────────────
# Gemini (default model — free tier available)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (optional — gpt-image-1 / dall-e-3, has usage cost)
OPENAI_API_KEY=your_openai_api_key

# Ideogram v2 (optional — alternative image model)
IDEOGRAM_API_KEY=your_ideogram_api_key

# ─── AI — Content Generation ──────────────────────────────────────────────────
# Anthropic Claude (server-side only — do NOT prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Telegram Lead Notifications ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Backend Hub (Blog Content Runner) ───────────────────────────────────────
# Local dev: http://localhost:4000
# Production: set to your deployed Backend Hub URL (e.g. https://hub.finnhouses.com)
NEXT_PUBLIC_HUB_URL=http://localhost:4000


# ─── Facebook Page (fb-backend) ───────────────────────────────────────────────
# สร้างได้จาก https://developers.facebook.com/ → App → Graph API Explorer
# ต้องขอ permission: pages_manage_posts, pages_read_engagement
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FB_PAGE_ID=your_fb_page_id
# FB_API_VERSION=v21.0
